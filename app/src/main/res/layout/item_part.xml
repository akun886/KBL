<?xml version="1.0" encoding="utf-8"?>
<!-- 合集里的一行：序号 / 歌名 / 时长。

     没有歌手列——一张合集就是一个 UP 主的，一百行印同一个名字只会把歌名挤窄。
     序号照 B 站的分 P 号（P1 就是 1），不是列表下标：用户在对 B 站页面时
     两边的号能对上。

     行高 44dp 比首页的 48dp 矮一点：这一栏要在一屏里放下十二三首，
     而它只是用来挑歌，不需要首页那种阅读距离。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <View
        android:id="@+id/part_sel"
        android:layout_width="3dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:background="@color/accent"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/part_index"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/part_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- 正在播的那一行的小频谱。没有歌手列，它就落在歌名与时长之间 -->
    <com.kunplayer.tv.ui.SpectrumView
        android:id="@+id/part_spectrum"
        android:layout_width="24dp"
        android:layout_height="13dp"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/part_dur"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
