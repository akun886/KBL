<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的」页：上半是账号，下半是播放设置。

     登录的唯一入口放在这里，不散在收藏页与历史页——否则「登录」会出现三次，
     而用户在电视上最不想做的事，就是在三个地方分别判断自己是不是已登录。

     0.29.0 起这一页多了四项播放设置（频谱样式 / 频谱颜色 / 响度均衡 / 返回桌面后继续播放）。
     它们不另开一页：这一页原本只有「头像 → 昵称 → 按钮」一条直线，空着下半屏；
     而四项设置各占一行、一行一个开关，正好是电视上最省事的形状——
     光标上下走，左右改值，不用进二级页面。

     整块包在 ScrollView 里：540dp 的屏减去页脚版本号，内容刚好卡着，
     哪天再加第五项就会溢出。能滚的页面比被切掉半行的页面安全。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:focusable="false"
        android:overScrollMode="never"
        android:paddingTop="26dp"
        android:paddingBottom="54dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 头像。没登录就整块收起来：一个空圆比「未登录」三个字更让人以为
                 这里该有个图却没加载出来 -->
            <ImageView
                android:id="@+id/account_face"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_album"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/account_guest"
                android:textColor="@color/text_primary"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/account_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/account_guest_sub"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/account_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_play"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="28dp"
                android:paddingTop="10dp"
                android:paddingEnd="28dp"
                android:paddingBottom="10dp"
                android:text="@string/account_login"
                android:textColor="#FF000000"
                android:textSize="18sp" />

            <!-- 异常记录。只在真留有崩溃文件时出现，平时不占位 -->
            <TextView
                android:id="@+id/account_diag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="420dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="@string/settings_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- 四项设置。行不写字也要能看出「可以改」：右边那个值用强调色，
                 光标落上去整行提亮（bg_row）。 -->
            <LinearLayout
                android:id="@+id/set_style_row"
                android:layout_width="420dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_style"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/set_style_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/set_color_row"
                android:layout_width="420dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_color"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <View
                    android:id="@+id/set_color_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_white" />

                <TextView
                    android:id="@+id/set_color_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/set_norm_row"
                android:layout_width="420dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_normalize"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/set_norm_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/set_bg_row"
                android:layout_width="420dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_background"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/set_bg_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 应用名 + 版本号。这是自用 sideload 包，最常问的一句就是「电视上装的是哪一版」，
         以前只能去系统设置里翻。文本在 paintAccount() 里填，因为版本号读 BuildConfig，
         写不进 XML。不可聚焦：这一页的焦点全在上面那些行上。 -->
    <TextView
        android:id="@+id/account_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 色板。盖在这一页上面，不是另开一页：颜色是从「频谱颜色」那一行点开的，
         跳到另一页去选，回来还得再认一遍自己选的是哪个频谱。

         一屏十格、一次看完：颜色是「看」出来的，不是「数」出来的——
         原来左右键一个个轮，选最后一个要按八下，还得记住刚才停在哪。

         没有「确定」：按下哪一格就已经生效了，再要一次确认只是让人多点一下。
         选错也只要再点一次，代价一样。 -->
    <FrameLayout
        android:id="@+id/palette_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/palette_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_picker"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <!-- 两行五列，行与行由 ColorPalette 按 COLORS 的个数自己铺 -->
            <LinearLayout
                android:id="@+id/palette_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center_horizontal"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
