<?xml version="1.0" encoding="utf-8"?>
<!-- 扫码登录浮层。全屏遮住内容区，只留一张卡：
     二维码、状态、一句提示。遥控器在这一层上只有「返回」一个有效键。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="32dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/login_title"
            android:textColor="@color/text_primary"
            android:textSize="25sp" />

        <!-- 二维码必须是黑码白底，反色扫不出来；尺寸固定 240dp，三米外手机也扫得进 -->
        <ImageView
            android:id="@+id/login_qr"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="22dp"
            android:background="#FFFFFFFF"
            android:contentDescription="@string/login_title"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/login_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/login_wait"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/login_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/login_hint"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
