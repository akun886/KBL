<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索页：左栏输入 + 历史，右栏结果。和首页是同一个骨架（左窄右宽 + 一条 1dp 分栏线）。

     输入只有一条路：电视自带的输入法（这台机器是搜狗 TV 版）。
     早先左栏还挂着一套自绘九宫格，只能打 a-z；一个中文歌名都搜不了，
     却要占掉左栏一整块。删掉之后左栏只剩输入框和历史的排布，
     400dp 是历史条读得舒服、又不至于把结果区挤窄的宽度。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:visibility="gone">

    <!-- 左栏：输入框 + 历史 -->
    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sidebar"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- 输入框就是输入法窗口的宿主。边打边搜，不需要额外的「确认」键：
             结果在右边整屏，多一颗按钮只能让输入行变挤 -->
        <com.kunplayer.tv.ui.ImeEditText
            android:id="@+id/search_ime_input"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_chip"
            android:hint="@string/search_placeholder"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <!-- 历史区的标题。放在 ScrollView 外面：跟着一起滚的话，往下翻几条之后
             顶部就剩半截卡片，看不出这一列是什么 -->
        <TextView
            android:id="@+id/search_hist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="@string/search_hist"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 搜索历史。由 MainActivity 在打开时按需铺，没有历史整块 gone。
             外面这层 ScrollView 是为了「存得比看得见的多」：左栏文件里留十条，
             多出来的靠这里翻——不给它滚动，第六条往后就永远见不到，等于没存。
             高度由代码按实际条数给（最多六行），不给死值，
             否则两条历史也占满一屏。
             focusable=false + afterDescendants：滚动本身不接焦点，
             焦点始终落在某一条历史上，不然会先停在 ScrollView 这个没有高亮的空层里。 -->
        <ScrollView
            android:id="@+id/search_hist_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/search_hist_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/hairline" />

    <!-- 右栏：结果 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="36dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/search_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>
</LinearLayout>
