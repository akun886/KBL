<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌标：字母 K。

     不是重新设计，是把原来那张 banner.png 里的 K 按像素重新描了一遍：
     竖笔从 x65 到 x89（宽 25），笔高 112；右上一笔白色、右下一笔橙色，
     两笔在竖笔的中线（y89.5）交汇于 (122, 90)，水平厚度都是 27。
     viewport 用的就是原始像素坐标（99 × 112），所以比例与旧图完全一致，
     放多大都不会再糊。

     白色没有取纯白而是 #F2F5F7、橙取 #FF8A3D，都和旧图取样值一致：
     纯白在深底上会发灰，橙再亮一档就偏黄。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="21dp"
    android:height="24dp"
    android:viewportWidth="99"
    android:viewportHeight="112">

    <!-- 竖笔 -->
    <path
        android:fillColor="#FFF2F5F7"
        android:pathData="M0,0 L25.4,0 L25.4,112 L0,112 Z" />

    <!-- 右上一笔：顶边 72→99，收到底边。左端一直压到竖笔右边（25.4），
         不在拐角处留缝——原图里 K 的两个斜笔和竖笔是长在一起的，
         按平行四边形的算法收在 30 会露出一条背景色的斜缝 -->
    <path
        android:fillColor="#FFF2F5F7"
        android:pathData="M72,0 L99,0 L57,56 L25.4,56 Z" />

    <!-- 右下一笔：从交汇点撇到右下角 -->
    <path
        android:fillColor="#FFFF8A3D"
        android:pathData="M25.4,56 L57,56 L99,112 L72,112 Z" />
</vector>
