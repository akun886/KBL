<?xml version="1.0" encoding="utf-8"?>
<!-- 侧栏底。原来是纯色 @color/sidebar（#121215），现在底下铺了封面模糊，
     纯色会把左边缘切出一条硬边——封面再好看也到不了这一栏。

     改成 94% 不透明：透上来的是封面的色相，不是画面。侧栏里九项导航都是
     14sp 的小字，让图透进来会直接吃掉对比度。

     用 drawable 而不是改 @color/sidebar：那个色值同时给别的界面用，
     这一栏要的是「毛玻璃」而不是一个更暗的灰。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F0121215" />
</shape>
