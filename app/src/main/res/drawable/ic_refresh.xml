<?xml version="1.0" encoding="utf-8"?>
<!-- 「换一批」：一圈顺时针的箭头。
     和底栏那几颗一样走描边不填色，1.8dp 的线在 34dp 的圆玻璃里刚好看得清：
     填色版（Material 那颗 refresh）的缺口在 18dp 上会糊成一个实心圆点。

     几何是刻意的：圆弧只画 270°（从右侧 3 点起、顺时针到 12 点），
     顶上那一小段留空，箭头就在 12 点朝着 3 点——缺口、箭头、方向三者对上，
     一眼读出来是「转一圈重来」。上一版画了 300° 的圆只留 60° 的缝，
     箭头挤在缝里，放大看像个带钩的圆圈。
     箭头两支各 2.8dp，比弧线短一截：长了会盖住缺口，短了认不出是箭头。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M19,12 A7,7 0 1,1 12,5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <path
        android:fillColor="#00000000"
        android:pathData="M9.2,2.6 L12,5 L9.2,7.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />
</vector>
